{
  "description": "Issue #4084 scenario H1: parent (lunahigh) with code mode on runs task A itself.",
  "tmux": {
    "cols": 140,
    "rows": 45,
    "historyLimit": 50000,
    "scrollbackLines": 8000,
    "initialWaitMs": 8000
  },
  "yolo": true,
  "startCommand": [
    "bun",
    "scripts/start.ts",
    "--profile-load",
    "lunahigh",
    "--set",
    "code-mode=on"
  ],
  "steps": [
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "Type your message",
      "timeoutMs": 90000
    },
    {
      "type": "capture",
      "label": "ready"
    },
    {
      "type": "line",
      "text": "Find every TODO or FIXME comment in TypeScript files changed in the last 10 commits. For each, use git blame to find the author of that line. Give me counts per author and the total.",
      "postTypeMs": 1500
    },
    {
      "type": "wait",
      "ms": 3000
    },
    {
      "type": "capture",
      "label": "prompt-submitted"
    },
    {
      "type": "waitForNot",
      "scope": "screen",
      "contains": "esc to cancel",
      "timeoutMs": 900000
    },
    {
      "type": "wait",
      "ms": 2000
    },
    {
      "type": "capture",
      "label": "answer"
    },
    {
      "type": "line",
      "text": "/stats",
      "postTypeMs": 800
    },
    {
      "type": "waitFor",
      "scope": "scrollback",
      "contains": "Session Stats",
      "timeoutMs": 30000
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "capture",
      "label": "stats"
    },
    {
      "type": "line",
      "text": "/quit",
      "submitKeys": ["Escape", "Enter"]
    },
    {
      "type": "waitForExit",
      "timeoutMs": 60000
    }
  ]
}
