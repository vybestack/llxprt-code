{
  "tmux": {
    "cols": 160,
    "rows": 45,
    "initialWaitMs": 3000,
    "historyLimit": 20000,
    "scrollbackLines": 3000
  },
  "startCommand": [
    "env CI=0 CONTINUOUS_INTEGRATION=0 NODE_OPTIONS= LLXPRT_CODE_NO_RELAUNCH=true LLXPRT_CODE_SKIP_TERMINAL_CAPABILITY_DETECTION=true LLXPRT_CODE_BUILTIN_COMMANDS_ONLY=true LLXPRT_CODE_SUPPRESS_STATIC_HEADER=true LLXPRT_CODE_WELCOME_CONFIG_PATH=scripts/fixtures/welcome-completed.json LLXPRT_SYSTEM_SETTINGS_PATH=\"${LLXPRT_UI_TASK_SETTINGS:-$PWD/scripts/fixtures/task-approval-settings.json}\" ${bun} scripts/fixtures/task-approval-launch.ts"
  ],
  "yolo": false,
  "steps": [
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "Type your message",
      "timeoutMs": 30000
    },
    {
      "type": "line",
      "text": "Exercise Task child approval routing.",
      "postTypeMs": 600
    },
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "Allow once",
      "timeoutMs": 30000
    },
    { "type": "capture", "label": "parent-approval", "scope": "screen" },
    {
      "type": "approveTool",
      "confirmation": { "contains": "Allow once" },
      "choice": "once",
      "timeoutMs": 30000
    },
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "approval-child-",
      "timeoutMs": 30000
    },
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "printf CHILD_TOOL_COMPLETED",
      "timeoutMs": 30000
    },
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "Allow once",
      "timeoutMs": 30000
    },
    { "type": "capture", "label": "child-approval", "scope": "screen" },
    {
      "type": "approveTool",
      "confirmation": { "contains": "Allow once" },
      "choice": "once",
      "timeoutMs": 30000
    },
    {
      "type": "waitFor",
      "scope": "scrollback",
      "contains": "CHILD_APPROVAL_DONE",
      "timeoutMs": 30000
    },
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "TASK_APPROVAL_COMPLETE",
      "timeoutMs": 30000
    },
    { "type": "capture", "label": "completed", "scope": "screen" },
    { "type": "line", "text": "/quit", "postTypeMs": 600 },
    { "type": "waitForExit", "timeoutMs": 15000 }
  ]
}
