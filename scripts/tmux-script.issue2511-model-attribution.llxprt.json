{
  "tmux": {
    "cols": 120,
    "rows": 40,
    "historyLimit": 100000,
    "scrollbackLines": 20000,
    "initialWaitMs": 10000
  },
  "startCommand": ["bun", "scripts/start.ts"],
  "yolo": true,
  "steps": [
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "Type your message",
      "timeoutMs": 90000
    },
    { "type": "line", "text": "/profile load zai", "submitKeys": [] },
    { "type": "key", "key": "Enter" },
    { "type": "wait", "ms": 400 },
    { "type": "key", "key": "Enter" },
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "loaded",
      "timeoutMs": 30000
    },
    { "type": "wait", "ms": 2000 },
    { "type": "capture", "label": "00-after-profile", "scope": "screen" },
    {
      "type": "line",
      "text": "Write me a haiku about mountains and nothing else.",
      "submitKeys": ["Enter"]
    },
    {
      "type": "waitFor",
      "scope": "scrollback",
      "contains": "esc to cancel",
      "timeoutMs": 60000
    },
    {
      "type": "waitForNot",
      "scope": "screen",
      "contains": "esc to cancel",
      "timeoutMs": 240000
    },
    { "type": "wait", "ms": 2000 },
    { "type": "capture", "label": "01-haiku-screen", "scope": "screen" },
    { "type": "line", "text": "/quit", "submitKeys": ["Enter"] },
    { "type": "waitForExit", "timeoutMs": 20000 }
  ]
}
