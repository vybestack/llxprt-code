{
  "tmux": {
    "cols": 160,
    "rows": 45,
    "initialWaitMs": 3000,
    "historyLimit": 20000,
    "scrollbackLines": 3000
  },
  "startCommand": [
    "env CI=0 CONTINUOUS_INTEGRATION=0 NO_COLOR=true FORCE_COLOR=0 NODE_OPTIONS= LLXPRT_CODE_NO_RELAUNCH=true LLXPRT_CODE_SKIP_TERMINAL_CAPABILITY_DETECTION=true LLXPRT_CODE_BUILTIN_COMMANDS_ONLY=true LLXPRT_CODE_WELCOME_CONFIG_PATH=scripts/fixtures/welcome-completed.json LLXPRT_SYSTEM_SETTINGS_PATH=\"${LLXPRT_UI_RENDER_SETTINGS:-$PWD/scripts/system-settings.interactive-ui.json}\" LLXPRT_FAKE_RESPONSES=scripts/fixtures/journal-render.responses.jsonl ${bun} packages/cli/index.ts --provider fake --model fake-model --yolo"
  ],
  "steps": [
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "Type your message",
      "timeoutMs": 30000
    },
    {
      "type": "capture",
      "label": "startup"
    },
    {
      "type": "line",
      "text": "Exercise the journal rendering fixture.",
      "postTypeMs": 600
    },
    {
      "type": "waitFor",
      "scope": "scrollback",
      "contains": "RENDER_THINKING",
      "timeoutMs": 30000
    },
    {
      "type": "capture",
      "label": "thinking"
    },
    {
      "type": "waitFor",
      "scope": "scrollback",
      "contains": "LONG_OUTPUT_READY",
      "timeoutMs": 30000
    },
    {
      "type": "capture",
      "label": "long-output"
    },
    {
      "type": "line",
      "text": "Now run the parallel rendering fixture.",
      "postTypeMs": 600
    },
    {
      "type": "waitFor",
      "scope": "scrollback",
      "contains": "Parallel B",
      "timeoutMs": 30000
    },
    {
      "type": "capture",
      "label": "parallel"
    },
    {
      "type": "waitFor",
      "scope": "scrollback",
      "contains": "RENDER_FINAL:",
      "timeoutMs": 30000
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "capture",
      "label": "final"
    },
    {
      "type": "line",
      "text": "/quit"
    },
    {
      "type": "waitForExit",
      "timeoutMs": 15000
    }
  ]
}
