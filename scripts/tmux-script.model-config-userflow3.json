{
  "session": {
    "name": "llxprt-model-config-userflow3",
    "cwd": ".",
    "size": {
      "cols": 100,
      "rows": 30
    },
    "startCommand": "bun scripts/start.ts"
  },
  "steps": [
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "Type your message",
      "timeoutMs": 60000,
      "pollMs": 500
    },
    {
      "type": "capture",
      "label": "00-startup"
    },
    {
      "type": "line",
      "text": "/provider kimi",
      "submitKeys": ["Enter"],
      "postTypeMs": 800
    },
    {
      "type": "wait",
      "ms": 5000
    },
    {
      "type": "capture",
      "label": "01-after-provider-kimi"
    },
    {
      "type": "line",
      "text": "/key load kimi",
      "submitKeys": ["Enter"],
      "postTypeMs": 800
    },
    {
      "type": "wait",
      "ms": 5000
    },
    {
      "type": "capture",
      "label": "02-after-key-load"
    },
    {
      "type": "key",
      "key": "C-c"
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "capture",
      "label": "02b-after-ctrlc"
    },
    {
      "type": "line",
      "text": "/model",
      "submitKeys": ["Enter"],
      "postTypeMs": 800
    },
    {
      "type": "wait",
      "ms": 15000
    },
    {
      "type": "capture",
      "label": "03-after-model-command"
    },
    {
      "type": "key",
      "key": "Down"
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "key",
      "key": "Enter"
    },
    {
      "type": "wait",
      "ms": 10000
    },
    {
      "type": "capture",
      "label": "04-after-model-select"
    },
    {
      "type": "key",
      "key": "Escape"
    },
    {
      "type": "wait",
      "ms": 2000
    },
    {
      "type": "capture",
      "label": "05-after-escape"
    }
  ]
}
