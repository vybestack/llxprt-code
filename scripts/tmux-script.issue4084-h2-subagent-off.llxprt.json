{
  "description": "Issue #4084 scenario H2: parent with code mode off delegates task A to a cheap subagent (profile issue4084-haiku-code-off: haiku, code mode off). Run `bun scripts/issue4084-subagent-setup.ts` first.",
  "tmux": {
    "cols": 140,
    "rows": 45,
    "historyLimit": 50000,
    "scrollbackLines": 8000,
    "initialWaitMs": 8000
  },
  "yolo": true,
  "startCommand": [
    "bun",
    "scripts/start.ts",
    "--profile-load",
    "lunahigh",
    "--set",
    "code-mode=off"
  ],
  "steps": [
    {
      "type": "waitFor",
      "scope": "screen",
      "contains": "Type your message",
      "timeoutMs": 90000
    },
    {
      "type": "capture",
      "label": "ready"
    },
    {
      "type": "line",
      "text": "Use the task tool with subagent_name \"issue4084-gatherer-off\" and give it this goal: \"Find every TODO or FIXME comment in TypeScript files changed in the last 10 commits. For each, use git blame to find the author of that line. Give me counts per author and the total.\" Then report the subagent's answer.",
      "postTypeMs": 1500
    },
    {
      "type": "wait",
      "ms": 3000
    },
    {
      "type": "capture",
      "label": "prompt-submitted"
    },
    {
      "type": "waitForNot",
      "scope": "screen",
      "contains": "esc to cancel",
      "timeoutMs": 900000
    },
    {
      "type": "wait",
      "ms": 2000
    },
    {
      "type": "capture",
      "label": "answer"
    },
    {
      "type": "line",
      "text": "/stats",
      "postTypeMs": 800
    },
    {
      "type": "waitFor",
      "scope": "scrollback",
      "contains": "Session Stats",
      "timeoutMs": 30000
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "capture",
      "label": "stats"
    },
    {
      "type": "line",
      "text": "/quit",
      "submitKeys": ["Escape", "Enter"]
    },
    {
      "type": "waitForExit",
      "timeoutMs": 60000
    }
  ]
}
