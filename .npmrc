@vybestack:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}

# Dependency cooldown (issue #3930): refuse package versions published less
# than 3 days ago so freshly hijacked releases are not installed before the
# registry and scanners react. Units are days (npm >= 11.10).
min-release-age=3
# Our own packages and the Bun runtime packages are exempt, so security pins
# and the nightly dist-tag install are never delayed.
min-release-age-exclude[]=@vybestack/*
min-release-age-exclude[]=bun
min-release-age-exclude[]=@oven/bun-*
