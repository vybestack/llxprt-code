{
  "name": "kimi",
  "modelsDevProviderId": "kimi-for-coding",
  "baseProvider": "openai",
  "base-url": "https://api.kimi.com/coding/v1",
  "defaultModel": "kimi-for-coding",
  "description": "Kimi For Coding OpenAI-compatible endpoint",
  "mediaSupport": {
    "inlineImages": true,
    "fileUpload": true,
    "videoSupport": true
  },
  "ephemeralSettings": {
    "context-limit": 262144,
    "max_tokens": 32768,
    "user-agent": "RooCode/1.0"
  },
  "staticModels": [
    {
      "id": "kimi-for-coding",
      "name": "Kimi For Coding (K2.7 Code)",
      "contextWindow": 262144,
      "maxOutputTokens": 32768
    },
    {
      "id": "kimi-for-coding-highspeed",
      "name": "Kimi For Coding Highspeed (K2.7 Code)",
      "contextWindow": 262144,
      "maxOutputTokens": 32768
    },
    {
      "id": "kimi-k3",
      "name": "Kimi K3",
      "contextWindow": 1048576,
      "maxOutputTokens": 131072
    },
    {
      "id": "k3-256k",
      "name": "Kimi K3 256K",
      "contextWindow": 262144,
      "maxOutputTokens": 131072
    }
  ],
  "modelDefaults": [
    {
      "pattern": "^kimi|^k3-256k$",
      "ephemeralSettings": {
        "reasoning.effort": "medium",
        "reasoning.enabled": true,
        "reasoning.includeInResponse": true,
        "reasoning.includeInContext": true,
        "reasoning.stripFromContext": "none",
        "max_tokens": 32768,
        "context-limit": 262144
      },
      "unallowedParameters": [
        "temperature",
        "top_p",
        "top_k",
        "frequency_penalty",
        "presence_penalty"
      ]
    },
    {
      "pattern": "kimi-k3",
      "ephemeralSettings": {
        "reasoning.effort": "max",
        "max_tokens": 131072,
        "context-limit": 1000000
      }
    },
    {
      "pattern": "k3-256k",
      "ephemeralSettings": {
        "reasoning.effort": "high",
        "max_tokens": 131072,
        "context-limit": 262144
      }
    }
  ]
}
