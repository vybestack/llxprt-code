{
  "name": "qwen",
  "modelsDevProviderId": "alibaba",
  "baseProvider": "openai",
  "base-url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
  "defaultModel": "qwen3-coder-plus",
  "description": "Qwen via Alibaba Cloud DashScope (OpenAI-compatible, API key)",
  "apiKeyEnv": "DASHSCOPE_API_KEY",
  "ephemeralSettings": {
    "context-limit": 1000000,
    "max_tokens": 65536
  },
  "staticModels": [
    {
      "id": "qwen3-coder-plus",
      "name": "Qwen3 Coder Plus",
      "contextWindow": 1000000,
      "maxOutputTokens": 65536
    }
  ],
  "modelDefaults": [
    {
      "pattern": "qwen3-coder-plus",
      "ephemeralSettings": {
        "context-limit": 1000000,
        "max_tokens": 65536
      }
    }
  ]
}
