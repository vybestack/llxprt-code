{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/providers.tsbuildinfo",
    "lib": ["DOM", "DOM.Iterable", "ES2021", "ES2022.Error"],
    "composite": false,
    "types": ["node", "bun-types/test", "bun-types/test-globals"],
    "baseUrl": ".",
    "paths": {
      "@vybestack/llxprt-code-providers": ["./index.ts"],
      "@vybestack/llxprt-code-providers/auth.js": ["./src/auth/index.ts"],
      "@vybestack/llxprt-code-providers/*": ["./src/*"],
      "@vybestack/llxprt-code-auth": ["../auth/src/index.ts"],
      "@vybestack/llxprt-code-auth/*": ["../auth/src/*"],
      "@vybestack/llxprt-code-core": ["../core/index.ts"],
      "@vybestack/llxprt-code-core/*": ["../core/src/*"],
      "@vybestack/llxprt-code-tools": ["../tools/index.ts"],
      "@vybestack/llxprt-code-tools/*": ["../tools/src/*"],
      "@vybestack/llxprt-code-mcp": ["../mcp/index.ts"],
      "@vybestack/llxprt-code-mcp/*": ["../mcp/src/*"],
      "@vybestack/llxprt-code-settings": ["../settings/index.ts"],
      "@vybestack/llxprt-code-settings/*": ["../settings/src/*"],
      "@vybestack/llxprt-code-telemetry": ["../telemetry/index.ts"],
      "@vybestack/llxprt-code-telemetry/*": ["../telemetry/src/*"]
    }
  },
  "include": [
    "../../bun-test-corrections.d.ts",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.json",
    "../core/src/types/wasm.d.ts",
    "../mcp/index.ts",
    "../mcp/src/**/*.ts",
    "../settings/index.ts",
    "../settings/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../mcp/src/auth/google-auth-provider.test.ts",
    "../mcp/src/auth/oauth-provider.authenticate.test.ts",
    "../mcp/src/auth/oauth-provider.token.test.ts",
    "../mcp/src/auth/token-storage/base-token-storage.test.ts",
    "../mcp/src/client/mcp-client-manager.partial-failure.test.ts",
    "../mcp/src/client/mcp-client-manager.restart.test.ts",
    "../mcp/src/client/mcp-client-manager.status-failure.test.ts",
    "../mcp/src/client/mcp-client-manager.test.ts",
    "../mcp/src/client/mcp-client-manager.trust.test.ts",
    "../mcp/src/client/mcp-client.disconnect-cleanup.test.ts",
    "../mcp/src/client/mcp-client.discover-rollback.test.ts",
    "../mcp/src/client/mcp-client.discovery.test.ts",
    "../mcp/src/client/mcp-client.lifecycle.test.ts",
    "../mcp/src/client/mcp-client.oauth.test.ts",
    "../mcp/src/client/mcp-client.resource-refresh.test.ts",
    "../mcp/src/client/mcp-client.stale-error.test.ts",
    "../mcp/src/client/mcp-client.tools.test.ts",
    "../mcp/src/client/mcp-client.transport.test.ts",
    "../mcp/src/client/mcp-discovery.authorization.test.ts",
    "../mcp/src/client/mcp-oauth-helpers.test.ts",
    "../mcp/src/client/mcp-public-api.test.ts",
    "../mcp/src/client/mcp-tool.confirm.test.ts",
    "../mcp/src/client/neutral-types.test.ts",
    "../mcp/src/client/retryable-client-disconnections.test.ts"
  ]
}
