{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["DOM", "DOM.Iterable", "ES2021", "ES2022.Error"],
    "composite": false,
    "types": ["node", "bun-types/test"],
    "baseUrl": ".",
    "rootDir": "..",
    "paths": {
      "@vybestack/llxprt-code-agents": ["../agents/index.ts"],
      "@vybestack/llxprt-code-core": ["../core/index.ts"],
      // The wildcard is live for DEPENDENCY sources compiled through this
      // project (agents imports core deep subpaths); a2a's own imports stay
      // constrained to the root by the eslint fail-closed rule and
      // scripts/a2a-boundary.
      "@vybestack/llxprt-code-core/*": ["../core/src/*"],
      "@vybestack/llxprt-code-mcp": ["../mcp/index.ts"],
      "@vybestack/llxprt-code-storage": ["../storage/dist/index.d.ts"]
    }
  },
  "include": [
    "../../bun-test-corrections.d.ts",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.json",
    "../mcp/index.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../core/tsconfig.build.json" }]
}
