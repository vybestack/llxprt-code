{
  "name": "@vybestack/llxprt-code-a2a-server",
  "version": "0.11.0",
  "private": true,
  "description": "LLxprt Code A2A Server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoliver/llxprt-code.git",
    "directory": "packages/a2a-server"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "llxprt-code-a2a-server": "dist/a2a-server.mjs"
  },
  "scripts": {
    "start": "node dist/src/http/server.js",
    "build": "bun ../../scripts/build_package.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "bun ../../scripts/run_bun_tests.ts --workspace a2a-server --junit junit.xml",
    "test:bun": "bun ../../scripts/run_bun_tests.ts --workspace a2a-server",
    "test:ci": "bun ../../scripts/run_bun_tests.ts --workspace a2a-server --junit junit.xml",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^0.3.7",
    "@google-cloud/storage": "^7.16.0",
    "@vybestack/llxprt-code-agents": "file:../agents",
    "@vybestack/llxprt-code-core": "file:../core",
    "@vybestack/llxprt-code-mcp": "file:../mcp",
    "@vybestack/llxprt-code-storage": "file:../storage",
    "dotenv": "^17.1.0",
    "express": "^5.2.0",
    "fs-extra": "^11.3.0",
    "strip-json-comments": "^3.1.1",
    "tar": "^7.5.22",
    "uuid": "^11.1.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/supertest": "^6.0.3",
    "@types/tar": "^6.1.13",
    "supertest": "^7.1.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24"
  }
}
