{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@vybestack/llxprt-code-agents": ["../agents/dist/index.d.ts"],
      "@vybestack/llxprt-code-agents/constants.js": [
        "../agents/dist/src/constants.d.ts"
      ],
      "@vybestack/llxprt-code-core": ["../core/dist/index.d.ts"],
      "@vybestack/llxprt-code-core/*": ["../core/dist/src/*"],
      "@vybestack/llxprt-code-mcp": ["../mcp/dist/mcp/index.d.ts"],
      "@vybestack/llxprt-code-mcp/*": ["../mcp/dist/mcp/src/*"],
      "@vybestack/llxprt-code-providers": ["../providers/dist/index.d.ts"],
      "@vybestack/llxprt-code-providers/*": ["../providers/dist/src/*"]
    }
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.json",
    "./package.json"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**",
    "src/**/__snapshots__/**",
    "**/__tests__/**",
    "**/*test-helpers*",
    "**/*TestSetup*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.bun.ts",
    "**/*.test-d.ts",
    "**/__mocks__/**",
    "**/*.testHelpers.ts",
    "**/*.test-helper.ts",
    "**/*.fixtures.ts",
    "**/src/test-utils/**",
    "**/*.bun.tsx",
    "**/integration-tests/**",
    "**/__testhelpers__/**"
  ]
}
