{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/telemetry.tsbuildinfo",
    "lib": ["DOM", "DOM.Iterable", "ES2021", "ES2022.Error"],
    "composite": false,
    "types": ["node", "bun-types/test", "bun-types/test-globals"],
    "baseUrl": ".",
    "paths": {
      "@vybestack/llxprt-code-telemetry": ["./index.ts"],
      "@vybestack/llxprt-code-telemetry/*": ["./src/*"]
    }
  },
  "include": [
    "../../bun-test-corrections.d.ts",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/debug/DebugLogger.test.ts",
    "src/debug/FileOutput.test.ts",
    "src/telemetry/canonicalConsumer.behavior.test.ts",
    "src/telemetry/types.test.ts"
  ]
}
