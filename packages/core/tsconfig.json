{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/core.tsbuildinfo",
    "lib": ["DOM", "DOM.Iterable", "ES2021", "ES2022.Error"],
    "composite": true,
    "types": ["node", "bun-types/test", "bun-types/test-globals"],
    "baseUrl": ".",
    "paths": {
      "@vybestack/llxprt-code-auth": ["../auth/src/index.ts"],
      "@vybestack/llxprt-code-core": ["./index.ts"],
      "@vybestack/llxprt-code-core/*": ["./src/*"],
      "@vybestack/llxprt-code-ide-integration": ["../ide-integration/index.ts"],
      "@vybestack/llxprt-code-ide-integration/*": ["../ide-integration/src/*"],
      "@vybestack/llxprt-code-mcp": ["../mcp/dist/mcp/index.d.ts"],
      "@vybestack/llxprt-code-mcp/*": ["../mcp/dist/mcp/src/*"],
      "@vybestack/llxprt-code-settings": ["../settings/index.ts"],
      "@vybestack/llxprt-code-settings/*": ["../settings/src/*"]
    }
  },
  "include": [
    "../../bun-test-corrections.d.ts",
    "index.ts",
    "src/**/*.ts",
    "src/prompts/*.d.ts",
    "src/**/*.json",
    "../settings/index.ts",
    "../settings/src/**/*.ts",
    "../ide-integration/index.ts",
    "../ide-integration/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../ide-integration/src/ide/__tests__/detect-ide.antigravity.test.ts",
    "../ide-integration/src/ide/detect-ide.test.ts",
    "../ide-integration/src/ide/ide-client-lifecycle.test.ts",
    "../ide-integration/src/ide/ide-client.test.ts",
    "../ide-integration/src/ide/ide-installer.test.ts",
    "../ide-integration/src/ide/ideContext.test.ts",
    "../ide-integration/src/ide/process-utils.test.ts",
    "../ide-integration/src/lsp/__tests__/lsp-entry-path.test.ts",
    "../ide-integration/src/lsp/__tests__/lsp-service-client-integration.test.ts",
    "../ide-integration/src/lsp/__tests__/lsp-service-client.test.ts",
    "../settings/src/__tests__/SettingsService.sessionScope.test.ts",
    "../settings/src/__tests__/SettingsService.test.ts",
    "../settings/src/__tests__/numericString.test.ts",
    "../settings/src/__tests__/settingsRegistry.issue2182.test.ts",
    "../settings/src/__tests__/settingsRegistry.issue2607.test.ts",
    "../settings/src/__tests__/settingsRegistry.issue2896.test.ts",
    "../settings/src/__tests__/settingsRegistry.redaction.test.ts",
    "../settings/src/__tests__/settingsRegistry.test.ts",
    "../settings/src/__tests__/settingsServiceInstance.test.ts",
    "../settings/src/profiles/ProfileManager.isolation.test.ts",
    "../settings/src/profiles/__tests__/ProfileManager.test.ts",
    "../settings/src/profiles/__tests__/canonicalProfileRepair.outcomes.test.ts",
    "../settings/src/profiles/__tests__/canonicalProfileRepair.test.ts",
    "../settings/src/profiles/__tests__/canonicalProfileRepair.testHelpers.ts",
    "../settings/src/profiles/__tests__/profileStore.crossProcess.test.ts",
    "../settings/src/profiles/__tests__/profileStore.test.ts",
    "../settings/src/storage/__tests__/Storage.test.ts"
  ],
  "references": [
    { "path": "../auth/tsconfig.build.json" },
    { "path": "../settings" },
    { "path": "../ide-integration" }
  ]
}
