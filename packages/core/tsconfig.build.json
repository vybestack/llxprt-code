{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.test-d.*",
    "**/*.spec.*",
    "**/*test-helpers*",
    "**/*.bun.ts",
    "**/*.test-d.ts",
    "**/__mocks__/**",
    "**/*.testHelpers.ts",
    "**/*.test-helper.ts",
    "**/*.fixtures.ts",
    "**/src/test-utils/**",
    "../settings/src/**/__tests__/**",
    "../settings/src/**/*.test.*",
    "../settings/src/**/*.test-d.*",
    "../settings/src/**/*.spec.*",
    "../ide-integration/src/**/__tests__/**",
    "../ide-integration/src/**/*.test.*",
    "../ide-integration/src/**/*.test-d.*",
    "../ide-integration/src/**/*.spec.*"
  ],
  "references": [
    { "path": "../auth/tsconfig.build.json" },
    { "path": "../settings" },
    { "path": "../ide-integration/tsconfig.build.json" }
  ]
}
