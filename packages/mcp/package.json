{
  "name": "@vybestack/llxprt-code-mcp",
  "version": "0.11.0",
  "description": "LLxprt Code MCP: Model Context Protocol client, OAuth, and token storage",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vybestack/llxprt-code.git"
  },
  "type": "module",
  "main": "dist/mcp/index.js",
  "types": "dist/mcp/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mcp/index.d.ts",
      "bun": "./index.ts",
      "import": "./dist/mcp/index.js"
    },
    "./config/mcpServerConfig.js": {
      "types": "./dist/mcp/src/config/mcpServerConfig.d.ts",
      "bun": "./src/config/mcpServerConfig.ts",
      "import": "./dist/mcp/src/config/mcpServerConfig.js"
    },
    "./host/hostInterfaces.js": {
      "types": "./dist/mcp/src/host/hostInterfaces.d.ts",
      "bun": "./src/host/hostInterfaces.ts",
      "import": "./dist/mcp/src/host/hostInterfaces.js"
    },
    "./host/hostServices.js": {
      "types": "./dist/mcp/src/host/hostServices.d.ts",
      "bun": "./src/host/hostServices.ts",
      "import": "./dist/mcp/src/host/hostServices.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build_package.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "bun ../../scripts/run_bun_tests.ts --workspace mcp --junit junit.xml",
    "test:bun": "bun ../../scripts/run_bun_tests.ts --workspace mcp",
    "test:ci": "bun ../../scripts/run_bun_tests.ts --workspace mcp --junit junit.xml",
    "typecheck": "tsc --noEmit -p tsconfig.noemit.json"
  },
  "files": [
    "index.ts",
    "src",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.test-d.ts",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/__tests__/**",
    "!**/__snapshots__/**",
    "!**/test-support/**",
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@vybestack/llxprt-code-auth": "file:../auth",
    "@vybestack/llxprt-code-settings": "file:../settings",
    "@vybestack/llxprt-code-storage": "file:../storage",
    "@vybestack/llxprt-code-telemetry": "file:../telemetry",
    "@vybestack/llxprt-code-tools": "file:../tools",
    "google-auth-library": "^9.11.0",
    "shell-quote": "^1.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "fast-check": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24"
  }
}
