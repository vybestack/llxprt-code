{
  "name": "@vybestack/llxprt-code-settings",
  "version": "0.12.0",
  "description": "LLxprt Code Settings — settings, profiles, and storage type boundaries",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vybestack/llxprt-code.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./index.ts",
      "import": "./dist/index.js"
    },
    "./settings/SettingsService.js": {
      "types": "./dist/src/settings/SettingsService.d.ts",
      "bun": "./src/settings/SettingsService.ts",
      "import": "./dist/src/settings/SettingsService.js"
    },
    "./settings/settingsRegistry.js": {
      "types": "./dist/src/settings/settingsRegistry.d.ts",
      "bun": "./src/settings/settingsRegistry.ts",
      "import": "./dist/src/settings/settingsRegistry.js"
    },
    "./profiles/ProfileManager.js": {
      "types": "./dist/src/profiles/ProfileManager.d.ts",
      "bun": "./src/profiles/ProfileManager.ts",
      "import": "./dist/src/profiles/ProfileManager.js"
    },
    "./profiles/types.js": {
      "types": "./dist/src/profiles/types.d.ts",
      "bun": "./src/profiles/types.ts",
      "import": "./dist/src/profiles/types.js"
    },
    "./storage/Storage.js": {
      "types": "./dist/src/storage/Storage.d.ts",
      "bun": "./src/storage/Storage.ts",
      "import": "./dist/src/storage/Storage.js"
    },
    "./settings/ephemeral-settings.js": {
      "types": "./dist/src/settings/ephemeral-settings.d.ts",
      "bun": "./src/settings/ephemeral-settings.ts",
      "import": "./dist/src/settings/ephemeral-settings.js"
    },
    "./settings/cli-ephemeral-settings.js": {
      "types": "./dist/src/settings/cli-ephemeral-settings.d.ts",
      "bun": "./src/settings/cli-ephemeral-settings.ts",
      "import": "./dist/src/settings/cli-ephemeral-settings.js"
    },
    "./settings/model-param-parser.js": {
      "types": "./dist/src/settings/model-param-parser.d.ts",
      "bun": "./src/settings/model-param-parser.ts",
      "import": "./dist/src/settings/model-param-parser.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build_package.ts",
    "test": "bun ../../scripts/run_bun_tests.ts --workspace settings --junit junit.xml",
    "test:ci": "bun ../../scripts/run_bun_tests.ts --workspace settings --junit junit.xml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test:bun": "bun ../../scripts/run_bun_tests.ts --workspace settings"
  },
  "files": [
    "index.ts",
    "src",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/__tests__/**",
    "!**/__snapshots__/**",
    "dist"
  ],
  "dependencies": {
    "@vybestack/llxprt-code-storage": "file:../storage",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
