{
  "name": "@vybestack/llxprt-code-agents",
  "version": "0.11.0",
  "description": "LLxprt Code Agents — agent runtime, chat loop, and subagent orchestration",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vybestack/llxprt-code.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./index.ts",
      "import": "./dist/index.js"
    },
    "./internals.js": {
      "types": "./dist/src/internals.d.ts",
      "bun": "./src/internals.ts",
      "import": "./dist/src/internals.js"
    },
    "./app-service.js": {
      "types": "./dist/src/app-service.d.ts",
      "bun": "./src/app-service.ts",
      "import": "./dist/src/app-service.js"
    },
    "./constants.js": {
      "types": "./dist/src/constants.d.ts",
      "bun": "./src/constants.ts",
      "import": "./dist/src/constants.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build_package.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "pretest": "bun ../../scripts/check-agents-api-surface.ts",
    "test": "bun run-bun-tests.ts && bun ../../scripts/run_bun_tests.ts --workspace agents",
    "test:ci": "bun run-bun-tests.ts && bun ../../scripts/run_bun_tests.ts --workspace agents",
    "typecheck": "tsc --noEmit -p tsconfig.noemit.json && tsc --noEmit -p tsconfig.test-bun.json"
  },
  "files": [
    "index.ts",
    "src",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/__tests__/**",
    "!**/__snapshots__/**",
    "dist"
  ],
  "dependencies": {
    "@vybestack/llxprt-code-auth": "file:../auth",
    "@vybestack/llxprt-code-core": "file:../core",
    "@vybestack/llxprt-code-ide-integration": "file:../ide-integration",
    "@vybestack/llxprt-code-policy": "file:../policy",
    "@vybestack/llxprt-code-providers": "file:../providers",
    "@vybestack/llxprt-code-settings": "file:../settings",
    "@vybestack/llxprt-code-tools": "file:../tools",
    "diff": "^8.0.3",
    "fast-levenshtein": "^2.0.6",
    "undici": "^7.29.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@vybestack/llxprt-code-test-utils": "file:../test-utils",
    "fast-check": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24"
  }
}
