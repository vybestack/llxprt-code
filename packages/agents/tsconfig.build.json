{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@vybestack/llxprt-code-auth": ["../auth/dist/index.d.ts"],
      "@vybestack/llxprt-code-auth/*": ["../auth/dist/src/*"],
      "@vybestack/llxprt-code-core": ["../core/dist/index.d.ts"],
      "@vybestack/llxprt-code-core/*": ["../core/dist/src/*"],
      "@vybestack/llxprt-code-providers": ["../providers/dist/index.d.ts"],
      "@vybestack/llxprt-code-providers/*": ["../providers/dist/src/*"],
      "@vybestack/llxprt-code-settings": ["../settings/dist/index.d.ts"],
      "@vybestack/llxprt-code-settings/*": ["../settings/dist/src/*"],
      "@vybestack/llxprt-code-tools": ["../tools/dist/index.d.ts"],
      "@vybestack/llxprt-code-tools/*": ["../tools/dist/src/*"]
    }
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/**/*.json",
    "../../node_modules/bun-types/test.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/test-utils/**",
    "src/**/__tests__/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*test-helpers*",
    "**/*.bun.ts",
    "**/*.test-d.ts",
    "**/__mocks__/**",
    "**/*.testHelpers.ts",
    "**/*.test-helper.ts",
    "**/*.fixtures.ts"
  ]
}
