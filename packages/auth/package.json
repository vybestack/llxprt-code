{
  "name": "@vybestack/llxprt-code-auth",
  "version": "0.11.0",
  "description": "LLxprt Code Auth — authentication and authorization domain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vybestack/llxprt-code.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./index.ts",
      "import": "./dist/index.js"
    },
    "./oauth-errors.js": {
      "types": "./dist/src/oauth-errors.d.ts",
      "bun": "./src/oauth-errors.ts",
      "import": "./dist/src/oauth-errors.js"
    },
    "./oauth-ui-bridge.js": {
      "types": "./dist/src/oauth-ui-bridge.d.ts",
      "bun": "./src/oauth-ui-bridge.ts",
      "import": "./dist/src/oauth-ui-bridge.js"
    },
    "./precedence.js": {
      "types": "./dist/src/precedence.d.ts",
      "bun": "./src/precedence.ts",
      "import": "./dist/src/precedence.js"
    },
    "./token-merge.js": {
      "types": "./dist/src/token-merge.d.ts",
      "bun": "./src/token-merge.ts",
      "import": "./dist/src/token-merge.js"
    },
    "./token-sanitization.js": {
      "types": "./dist/src/token-sanitization.d.ts",
      "bun": "./src/token-sanitization.ts",
      "import": "./dist/src/token-sanitization.js"
    },
    "./types.js": {
      "types": "./dist/src/types.d.ts",
      "bun": "./src/types.ts",
      "import": "./dist/src/types.js"
    },
    "./flows/codex-device-flow.js": {
      "types": "./dist/src/flows/codex-device-flow.d.ts",
      "bun": "./src/flows/codex-device-flow.ts",
      "import": "./dist/src/flows/codex-device-flow.js"
    },
    "./proxy/framing.js": {
      "types": "./dist/src/proxy/framing.d.ts",
      "bun": "./src/proxy/framing.ts",
      "import": "./dist/src/proxy/framing.js"
    },
    "./proxy/proxy-provider-key-storage.js": {
      "types": "./dist/src/proxy/proxy-provider-key-storage.d.ts",
      "bun": "./src/proxy/proxy-provider-key-storage.ts",
      "import": "./dist/src/proxy/proxy-provider-key-storage.js"
    },
    "./proxy/proxy-token-store.js": {
      "types": "./dist/src/proxy/proxy-token-store.d.ts",
      "bun": "./src/proxy/proxy-token-store.ts",
      "import": "./dist/src/proxy/proxy-token-store.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build_package.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "index.ts",
    "src",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/__tests__/**",
    "!**/__snapshots__/**",
    "dist"
  ],
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "fast-check": "^4.8.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=24"
  }
}
